rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.role == "admin";
    }

    function isOwner(ownerUid) {
      return isSignedIn() && request.auth.uid == ownerUid;
    }

    function validRequest(data) {
      return data.keys().hasAll(["ownerUid", "status", "paymentState", "signatureState", "fields", "createdAt", "updatedAt"])
        && data.ownerUid is string
        && data.status in [
          "Pending",
          "1 Approved Info",
          "1.1 Pmt Req to Party1",
          "1.2 Pmt Req to Party2",
          "2 Paid in Full",
          "3 Appearance Filed",
          "4 Drafted Dave to Review",
          "4.1 Ready for DocuSign",
          "5 Reviewed, Out for Client Sign",
          "6 Clients Signed, Filed in Court",
          "7 Judge Signed, Get Certified",
          "7.7 Send Cert to Admin E-MAIL",
          "7.8 Send Cert to Admin FAX",
          "7.9 Send Cert to Admin MAIL",
          "8 Got Cert, Sent to Plan Admin",
          "8.1 Email1 Client Status30",
          "8.2 Email1 Admin Status30",
          "8.3 Fax1 Admin Status30",
          "8.4 Mail1 Admin Status30",
          "8.5 Admin Status60",
          "8.6 Admin Status90",
          "8.7 Admin Status120+",
          "9 Administrator Approved",
          "9.1 Approved by Client",
          "10 Withdrawal and Closed File",
          "11 Archived"
        ]
        && data.paymentState in ["unpaid", "pending", "paid", "waived"]
        && data.signatureState in ["not_started", "sent", "partially_signed", "completed"]
        && data.fields is map;
    }

    function validUser(data) {
      return data.keys().hasOnly(["uid", "email", "displayName", "role", "createdAt", "updatedAt"])
        && data.uid is string
        && data.email is string
        && data.displayName is string
        && data.role in ["client", "admin"];
    }

    match /users/{userId} {
      allow read: if isAdmin() || isOwner(userId);
      allow create: if isOwner(userId) && validUser(request.resource.data) && request.resource.data.role == "client";
      allow update: if (isOwner(userId) && validUser(request.resource.data) && resource.data.role == request.resource.data.role)
        || isAdmin();
      allow delete: if isAdmin();
    }

    match /requests/{requestId} {
      allow read: if isAdmin() || isOwner(resource.data.ownerUid);
      allow create: if isSignedIn()
        && validRequest(request.resource.data)
        && request.resource.data.ownerUid == request.auth.uid;
      allow update: if (isOwner(resource.data.ownerUid)
          && request.resource.data.ownerUid == resource.data.ownerUid
          && validRequest(request.resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["fields", "files", "updatedAt", "status"]))
        || (isAdmin() && validRequest(request.resource.data));
      allow delete: if isAdmin();
    }

    match /requestFiles/{fileId} {
      allow read: if isAdmin() || isOwner(resource.data.ownerUid);
      allow create, update: if isSignedIn() && (isAdmin() || request.resource.data.ownerUid == request.auth.uid);
      allow delete: if isAdmin();
    }

    match /notes/{noteId} {
      allow read: if isAdmin() || (isOwner(resource.data.ownerUid) && resource.data.visibility == "client");
      allow create, update, delete: if isAdmin();
    }

    match /formSchemas/{schemaId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /documentTemplates/{templateId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /auditLog/{entryId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
